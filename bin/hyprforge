#!/bin/sh
# Hyprforge - a desktop designer for Hyprland.
#
# The widget layer runs as a Quickshell daemon; the editor is an overlay it
# opens on request. This script is what the start-menu entry and the keybind
# both call: it talks to a running daemon over IPC, and starts one first if
# there isn't one yet.

CONFIG=hyprforge
UNIT=hyprforge.service

# When the systemd unit is installed it owns the daemon's lifecycle: starting
# or stopping behind its back leaves systemd's idea of the service wrong, and a
# plain kill can trip its restart logic.
managed() {
    systemctl --user cat "$UNIT" >/dev/null 2>&1
}

# Forge used to live under ~/.config/caelestia/forge, back when caelestia was
# a hard requirement. Anyone upgrading past that rename should keep their
# layout, and they will not necessarily have run the installer to get it.
STATE="${XDG_CONFIG_HOME:-$HOME/.config}/hyprforge"
LEGACY="${XDG_CONFIG_HOME:-$HOME/.config}/caelestia/forge"
if [ ! -f "$STATE/layout.json" ] && [ -f "$LEGACY/layout.json" ]; then
    mkdir -p "$STATE"
    cp -a "$LEGACY/." "$STATE/" 2>/dev/null &&
        echo "hyprforge: migrated your layout from $LEGACY" >&2
fi

ipc() {
    qs -c "$CONFIG" ipc call "$@" 2>/dev/null
}

start_daemon() {
    # -n is the single-instance guard: without it a second launch happily
    # starts another daemon, and every widget is then drawn twice by two
    # layer surfaces stacked on the same output. The caelestia shell itself
    # is started the same way.
    qs -c "$CONFIG" -n -d >/dev/null 2>&1
    # Wait for the IPC socket rather than sleeping a fixed amount.
    i=0
    while [ "$i" -lt 50 ]; do
        ipc editor isOpen >/dev/null 2>&1 && return 0
        i=$((i + 1))
        sleep 0.1
    done
    return 1
}

case "${1:-edit}" in
    edit|open)   ipc editor open   >/dev/null || { start_daemon && ipc editor open >/dev/null; } ;;
    toggle)      ipc editor toggle >/dev/null || { start_daemon && ipc editor open >/dev/null; } ;;
    close)       ipc editor close  >/dev/null ;;
    widgets)     ipc layer toggle  >/dev/null || { start_daemon && ipc layer toggle >/dev/null; } ;;
    reload)      ipc layer reload  >/dev/null ;;
    fonts)
        # Everything after "fonts" goes straight to the font tool.
        shift
        exec hyprforge-fonts "$@"
        ;;
    sample)
        # Swap in one of the bundled layouts, keeping a backup of the current
        # one - this replaces everything you have placed.
        name="${2:-}"
        # Packaged installs live in /etc/xdg; installer ones in ~/.config.
        dir="$HOME/.config/quickshell/$CONFIG/samples"
        [ -d "$dir" ] || dir="/etc/xdg/quickshell/$CONFIG/samples"
        if [ -z "$name" ]; then
            echo "available samples:"
            for f in "$dir"/*.json; do [ -e "$f" ] && echo "  $(basename "$f" .json)"; done
            exit 0
        fi
        src="$dir/$name.json"
        [ -f "$src" ] || { echo "hyprforge: no sample called '$name'" >&2; exit 1; }
        dst="$STATE/layout.json"
        [ -f "$dst" ] && cp "$dst" "$dst.bak"
        cp "$src" "$dst"
        ipc layer reload >/dev/null
        echo "loaded sample '$name' (previous layout saved as layout.json.bak)"
        ;;
    export)
        # A rice pack: the layout, the editor/appearance settings and the
        # font choices in one file. Deliberately plain JSON with a version
        # field rather than an archive - people will want to diff these,
        # paste them in issues, and ship them inside their own dotfiles.
        out="${2:-}"
        [ -n "$out" ] || { echo "usage: hyprforge export <file.hfrice>" >&2; exit 1; }
        [ -f "$STATE/layout.json" ] || { echo "hyprforge: nothing to export yet" >&2; exit 1; }
        python3 - "$STATE" "$out" <<'PYEOF'
import json, sys, os, datetime
state, out = sys.argv[1], sys.argv[2]

def load(name):
    p = os.path.join(state, name)
    if not os.path.exists(p):
        return None
    with open(p) as f:
        return json.load(f)

pack = {
    "hyprforge": 1,
    "exported": datetime.datetime.now().astimezone().replace(microsecond=0).isoformat(),
    "layout": load("layout.json"),
    "settings": load("settings.json"),
}
# geo-cache is a cached IP lookup, not part of a look, and shipping it would
# leak roughly where the author lives.
with open(out, "w") as f:
    json.dump(pack, f, indent=2)
n = len((pack.get("layout") or {}).get("widgets") or [])
print(f"exported {n} element(s) to {out}")
PYEOF
        ;;
    import)
        src="${2:-}"
        [ -n "$src" ] || { echo "usage: hyprforge import <file.hfrice> [--layout-only]" >&2; exit 1; }
        [ -f "$src" ] || { echo "hyprforge: no such file: $src" >&2; exit 1; }
        mkdir -p "$STATE"
        python3 - "$STATE" "$src" "${3:-}" <<'PYEOF'
import json, sys, os, shutil
state, src, flag = sys.argv[1], sys.argv[2], sys.argv[3]
with open(src) as f:
    pack = json.load(f)
if not isinstance(pack, dict) or "hyprforge" not in pack:
    sys.exit("hyprforge: that is not a Hyprforge rice pack")
if pack["hyprforge"] > 1:
    sys.exit(f"hyprforge: pack format v{pack['hyprforge']} is newer than this build understands")

def put(name, data):
    if data is None:
        return False
    p = os.path.join(state, name)
    if os.path.exists(p):
        shutil.copy2(p, p + ".bak")     # never overwrite a layout without a way back
    with open(p, "w") as f:
        json.dump(data, f, indent=2)
    return True

wrote = []
if put("layout.json", pack.get("layout")):
    wrote.append("layout")
if flag != "--layout-only" and put("settings.json", pack.get("settings")):
    wrote.append("settings")
print("imported " + ", ".join(wrote) + " (previous kept as *.json.bak)" if wrote else "nothing to import")
PYEOF
        ipc layer reload >/dev/null
        ;;
    uninstall)
        printf 'This removes Hyprforge. Your layout in %s is kept unless you say otherwise.\nContinue? [y/N] ' "$STATE"
        read -r reply
        case "$reply" in
            [yY]*) ;;
            *) echo "cancelled"; exit 0 ;;
        esac
        systemctl --user disable --now "$UNIT" >/dev/null 2>&1
        qs kill -c "$CONFIG" >/dev/null 2>&1
        rm -f "$HOME/.config/systemd/user/$UNIT"
        rm -f "${XDG_DATA_HOME:-$HOME/.local/share}/applications/hyprforge.desktop"
        rm -rf "$HOME/.config/quickshell/$CONFIG"
        systemctl --user daemon-reload >/dev/null 2>&1
        echo "removed the shell, the unit and the launcher entry."
        printf 'Also delete your layout and settings in %s? [y/N] ' "$STATE"
        read -r reply2
        case "$reply2" in
            [yY]*) rm -rf "$STATE"; echo "deleted $STATE" ;;
            *) echo "kept $STATE - reinstalling will pick it up again" ;;
        esac
        echo "finally, remove the CLI:  rm -f ~/.local/bin/hyprforge ~/.local/bin/hyprforge-fonts"
        ;;
    start)
        if managed; then
            systemctl --user start "$UNIT"
        else
            ipc editor isOpen >/dev/null 2>&1 || start_daemon
        fi
        ;;
    stop)
        # Quickshell's own instance registry, not a cmdline grep: a daemonised
        # instance rewrites its argv, so matching on /proc/PID/cmdline silently
        # finds nothing and leaves the daemon running.
        if managed; then
            systemctl --user stop "$UNIT"
        else
            qs kill -c "$CONFIG" >/dev/null 2>&1
        fi
        ;;
    restart)
        if managed; then
            systemctl --user restart "$UNIT"
        else
            qs kill -c "$CONFIG" >/dev/null 2>&1
            sleep 1
            start_daemon
        fi
        ;;
    status)
        if managed; then
            echo "unit: $(systemctl --user is-enabled $UNIT 2>/dev/null), $(systemctl --user is-active $UNIT 2>/dev/null)"
        fi
        if qs list --all 2>/dev/null | grep -q "$CONFIG/shell.qml"; then
            echo "running"
            ipc diag demand
        else
            echo "not running"
        fi
        ;;
    -h|--help|help)
        cat <<'USAGE'
hyprforge [command]

  edit      open the designer (default; starts the daemon if needed)
  toggle    open/close the designer
  close     close the designer
  widgets   show/hide the desktop widget layer
  reload    re-read layout.json from disk
  fonts ...  run the font tool (apply / revert / list / status)
  export FILE
            write your layout + settings to a shareable rice pack
  import FILE [--layout-only]
            load someone else's rice pack (yours is kept as *.bak)
  uninstall remove Hyprforge, optionally keeping your layout
  sample [name]
            list bundled layouts, or replace the current one with a sample
            (the layout you had is kept as layout.json.bak)
  start     start the widget daemon without opening the designer
  stop      stop the daemon (removes the widgets until next login)
  restart   stop and start it again
  status    whether it is running, and which services it is keeping awake
USAGE
        ;;
    *)
        echo "hyprforge: unknown command '$1' (try --help)" >&2
        exit 2
        ;;
esac
